{
    "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
    "runtime": {
        "version": "LuaJIT",
        "requirePattern": ["lua/?.lua", "lua/?/init.lua", "?.lua", "?/init.lua"]
    },
    "workspace": {
        "library": ["$VIMRUNTIME/lua"],
        "ignoreDir": [".git"]
    },
    "strict": {
        "requirePath": true,
        "arrayIndex": true,
        "docBaseConstMatchBaseType": false
    },
    "diagnostics": {
        "globals": [
            "MiniTest",
            "describe",
            "it",
            "setup",
            "before_each",
            "after_each",
            "teardown"
        ],
        "enables": [
            "incomplete-signature-doc",
            "missing-global-doc",
            "global-in-non-module",
            "missing-type-argument",
            "unnecessary-assert",
            "unnecessary-if"
        ],
        "severity": {
            "incomplete-signature-doc": "error",
            "missing-global-doc": "error",
            "unresolved-require": "error",
            "param-type-mismatch": "error",
            "return-type-mismatch": "error",
            "assign-type-mismatch": "error",
            "cast-type-mismatch": "error",
            "generic-constraint-mismatch": "error",
            "missing-fields": "error",
            "need-check-nil": "error"
        }
    }
}
