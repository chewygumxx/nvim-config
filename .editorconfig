# vim:set expandtab shiftwidth=4 filetype=editorconfig:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/nvim-config.git
# ::: :/.editorconfig
#
#

root = true

# ----------
# All files
# ----------
[*]

charset = utf-8

indent_size = 4
indent_style = space
trim_trailing_whitespace = true

end_of_line = lf
insert_final_newline = true

# ---------
# Markdown
# ---------
[*.md]
indent_size = 2

# ---------------------
# Tree-sitter queries
# ---------------------
# Not a preference: `ts_query_ls format` indents at two spaces and offers no
# option to change it, so this is the width the gate will rewrite to anyway.
# The modelines in `queries/*.scm` name the same width for the same reason.
[*.scm]
indent_size = 2
