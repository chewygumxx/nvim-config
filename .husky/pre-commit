#!/usr/bin/env sh
# vim:set expandtab shiftwidth=4 filetype=sh:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/nvim-config.git
# ::: :/.husky/pre-commit
#
#

# No `set -e`: each section below accumulates failures into `status` and
# keeps running the remaining sections, so one failing check doesn't hide
# problems in the others. A stray non-zero from any unguarded command must
# not abort the script early.
status=0

# --------
# Lua
# --------

if command -v luafmt >/dev/null 2>&1 && command -v luacheck >/dev/null 2>&1; then
    lua_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.lua' ':!**/symlink_*')
    if [ -n "$lua_files" ]; then
        echo "$lua_files" | xargs -d '\n' luafmt --write
        echo "$lua_files" | xargs -d '\n' git add --
        echo "$lua_files" | xargs -d '\n' luacheck || status=1
    fi
else
    echo "pre-commit: luafmt/luacheck not on PATH, skipping Lua checks" >&2
fi

# --------
# TOML
# --------

if command -v tombi >/dev/null 2>&1; then
    toml_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.toml' ':!**/symlink_*')
    if [ -n "$toml_files" ]; then
        echo "$toml_files" | xargs -d '\n' tombi format --offline
        echo "$toml_files" | xargs -d '\n' git add --
        echo "$toml_files" | xargs -d '\n' tombi lint --error-on-warnings --offline || status=1
    fi
else
    echo "pre-commit: tombi not on PATH, skipping TOML checks" >&2
fi

# --------
# JSON/YAML
# --------

if command -v npx >/dev/null 2>&1; then
    json_yaml_files=$(
        git diff --cached --name-only --diff-filter=ACMR \
            -- '*.json' '*.jsonc' '*.yaml' '*.yml' ':!**/symlink_*' |
            while IFS= read -r f; do [ -L "$f" ] || printf '%s\n' "$f"; done
    )
    if [ -n "$json_yaml_files" ]; then
        echo "$json_yaml_files" | xargs -d '\n' npx --no -- prettier --write
        echo "$json_yaml_files" | xargs -d '\n' git add --
    fi
else
    echo "pre-commit: npx not on PATH, skipping JSON/YAML checks" >&2
fi

exit $status
