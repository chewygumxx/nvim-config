#
#
# ~chewygumxx/nvim-config.git
# ::: :/.husky/pre-push
#
#

# Git LFS's own hook, which `git lfs install` cannot place while husky owns
# core.hooksPath. `spell/*.spl` is stored in LFS.
command -v git-lfs >/dev/null 2>&1 || {
    printf 'This repository uses Git LFS, but git-lfs is not on PATH.\n' >&2
    exit 2
}
git lfs pre-push "$@"
