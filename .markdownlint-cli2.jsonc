//
//
// ~chewygumxx/nvim-config.git
// ::: :/.markdownlint-cli2.jsonc
//
//

// Also the fallback `lua/spec/nvim-lint.lua` hands markdownlint-cli2 for a
// buffer whose project has no markdownlint configuration of its own.
{
    "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/v0.23.3/schema/markdownlint-cli2-config-schema.json",
    // The house style, which also stops a frontmatter `title:` counting as a
    // heading: `util.frontmatter` keeps it equal to the first heading, so
    // every such document would otherwise report two. `extends` resolves
    // against this file, so the fallback finds the package here wherever the
    // buffer is.
    "config": {
        "extends": "@chewygumxx/markdownlint-cli2-config"
    }
}
