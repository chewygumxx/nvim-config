//

// Also the fallback `lua/spec/nvim-lint.lua` hands markdownlint-cli2 for a
// buffer whose project has no markdownlint configuration of its own.
{
    "config": {
        // A document's frontmatter `title:` is kept equal to its first
        // heading by `util.frontmatter`, so counting the key as a heading
        // reports every such document as having two.
        "MD025": { "front_matter_title": "" }
    }
}
