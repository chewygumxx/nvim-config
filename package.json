{
    "name": "nvim-config",
    "description": "My Neovim configuration dotfiles",
    "private": true,
    "keywords": [
        "dotfiles",
        "neovim-config",
        "config"
    ],
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/chewygumxx/nvim-config",
    "repository": "github:chewygumxx/nvim-config",
    "engines": {
        "bun": ">=1.4"
    },
    "devDependencies": {
        "@chewygumxx/cz-commitlint": "^1.0.2",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "commitizen": "^4.3.2",
        "husky": "^9.1.7",
        "prettier": "^3.9.7",
        "remark-frontmatter": "^5.0.0",
        "remark-preset-lint-consistent": "^6.0.1",
        "remark-preset-lint-recommended": "^7.0.1",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "commit": "cz",
        "prepare": "test -d node_modules/husky && husky || true",
        "typecheck": "tsc"
    },
    "config": {
        "commitizen": {
            "path": "@chewygumxx/cz-commitlint"
        }
    },
    "remarkConfig": {
        "settings": {
            "bullet": "-"
        },
        "plugins": [
            "remark-frontmatter",
            "remark-preset-lint-recommended",
            "remark-preset-lint-consistent"
        ]
    },
    "prettier": {
        "overrides": [
            {
                "files": "*.jsonc",
                "options": {
                    "trailingComma": "none"
                }
            }
        ]
    }
}
