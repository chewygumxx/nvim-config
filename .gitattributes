* text=auto eol=lf


# ---------------------
# Sync Header Metadata
# ---------------------

/LICENSE    -sync-header-metadata
*.json      -sync-header-metadata

# `doc/nvim-config.txt` is deliberately absent here: it carries the header
# in `# %s`, and the action preserves whatever precedes a marker, so it
# syncs like any other file. `doc/tags` cannot: it is strict
# tag<TAB>file<TAB>pattern records with nowhere to put a comment, and
# `helptags` rewrites it on every generator run regardless.
/doc/tags   -sync-header-metadata

# ---------------------
# Spell
# ---------------------

# The compiled dictionary is 1.4 MB of binary, so it lives in Git LFS; the
# `.husky/` LFS hooks exist for it. The `.add` word list beside it is plain
# text on purpose, so a new word shows up as a readable diff. Neither can
# carry a header: a `#` line in the `.add` is legal but is rewritten by
# nothing that understands it, and the `.spl` is opaque.
spell/*.spl filter=lfs diff=lfs merge=lfs -text -sync-header-metadata
spell/*.add -sync-header-metadata
